{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://implement-rfc.local/schemas/routing.v2.json",
  "$defs": {
    "modelRoute": {
      "type": "object",
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": [
        "classes"
      ],
      "properties": {
        "minimum_cli_version": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "object",
          "required": [
            "mechanical",
            "balanced",
            "standard",
            "deep",
            "critical",
            "review",
            "implementation",
            "integration"
          ],
          "properties": {
            "mechanical": {
              "$ref": "#/$defs/modelRoute"
            },
            "balanced": {
              "$ref": "#/$defs/modelRoute"
            },
            "standard": {
              "$ref": "#/$defs/modelRoute"
            },
            "deep": {
              "$ref": "#/$defs/modelRoute"
            },
            "critical": {
              "$ref": "#/$defs/modelRoute"
            },
            "review": {
              "$ref": "#/$defs/modelRoute"
            },
            "implementation": {
              "$ref": "#/$defs/modelRoute"
            },
            "integration": {
              "$ref": "#/$defs/modelRoute"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema",
    "verified_as_of",
    "assignments",
    "providers",
    "session_routes"
  ],
  "properties": {
    "schema": {
      "const": "implement-rfc.routing.v2"
    },
    "verified_as_of": {
      "type": "string",
      "format": "date"
    },
    "assignments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "mechanical",
          "balanced",
          "standard",
          "deep",
          "critical",
          "review",
          "implementation"
        ]
      },
      "propertyNames": {
        "enum": [
          "rfc-utility",
          "rfc-scout",
          "rfc-test-runner",
          "rfc-reviewer",
          "rfc-worker",
          "rfc-worker-deep",
          "rfc-reviewer-critical",
          "rfc-implementer",
          "rfc-integrator"
        ]
      },
      "properties": {
        "rfc-integrator": {
          "const": "integration"
        },
        "rfc-implementer": {
          "const": "implementation"
        }
      }
    },
    "providers": {
      "type": "object",
      "required": [
        "codex",
        "claude"
      ],
      "properties": {
        "codex": {
          "$ref": "#/$defs/provider"
        },
        "claude": {
          "$ref": "#/$defs/provider"
        }
      },
      "additionalProperties": false
    },
    "session_routes": {
      "type": "object",
      "required": [
        "rfc-coordinator"
      ],
      "properties": {
        "rfc-coordinator": {
          "type": "object",
          "required": [
            "codex",
            "claude"
          ],
          "properties": {
            "codex": {
              "$ref": "#/$defs/modelRoute"
            },
            "claude": {
              "$ref": "#/$defs/modelRoute"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
