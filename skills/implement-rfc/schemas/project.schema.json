{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://implement-rfc.local/schemas/project.v2.json",
  "title": "implement-rfc project configuration",
  "description": "The only machine-read project-specific file in the portable implement-rfc skill. scripts/project_config.py validates it without a JSON Schema library; this schema documents the same contract.",
  "type": "object",
  "required": [
    "schema",
    "project",
    "display_name",
    "origin_repo_name",
    "rfc_root",
    "issue_root",
    "next_id",
    "reservations_dir",
    "allocate_id_command",
    "lanes",
    "lane_statuses",
    "terminal_rfc_status",
    "structure_gate",
    "attended_review_skill",
    "workstreams",
    "role_addenda"
  ],
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[^/][^\\n]*[^/]$"
    }
  },
  "properties": {
    "schema": {
      "const": "implement-rfc.project.v2"
    },
    "project": {
      "$ref": "#/$defs/token"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "session_prefix": {
      "$ref": "#/$defs/token",
      "description": "Optional legacy station key; station identity now lives in the remote-station skill's station.json."
    },
    "origin_repo_name": {
      "type": "string",
      "minLength": 1
    },
    "rfc_root": {
      "$ref": "#/$defs/relativePath"
    },
    "issue_root": {
      "$ref": "#/$defs/relativePath"
    },
    "next_id": {
      "type": "object",
      "required": [
        "mode",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "single-file",
            "per-area"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "reservations_dir": {
      "$ref": "#/$defs/relativePath"
    },
    "allocate_id_command": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "object",
      "required": [
        "backlog",
        "ready",
        "inbox",
        "in_progress",
        "parked",
        "blocked",
        "done"
      ],
      "additionalProperties": false,
      "properties": {
        "backlog": {
          "$ref": "#/$defs/token"
        },
        "ready": {
          "$ref": "#/$defs/token"
        },
        "in_progress": {
          "$ref": "#/$defs/token"
        },
        "parked": {
          "$ref": "#/$defs/token"
        },
        "blocked": {
          "$ref": "#/$defs/token"
        },
        "done": {
          "$ref": "#/$defs/token"
        },
        "inbox": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "lane_statuses": {
      "description": "Front-matter status word expected in each lane directory.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "terminal_rfc_status": {
      "type": "string",
      "minLength": 1
    },
    "structure_gate": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attended_review_skill": {
      "type": [
        "string",
        "null"
      ]
    },
    "station_registry_doc": {
      "$ref": "#/$defs/relativePath",
      "description": "Optional legacy station key; station identity now lives in the remote-station skill's station.json."
    },
    "workstreams": {
      "type": "object",
      "required": [
        "main"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "branch"
        ],
        "additionalProperties": false,
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "win",
              "linux",
              "mac"
            ]
          }
        }
      }
    },
    "role_addenda": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bookkeeping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deferring_lanes",
        "parked_on",
        "blocked_by_forbidden_prefixes",
        "link_roots",
        "protected_globs",
        "editable_globs"
      ],
      "properties": {
        "deferring_lanes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parked_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_by_forbidden_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "link_roots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_globs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "editable_globs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sequencing": {
      "enum": [
        "dependency",
        "ordered-index"
      ]
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "rewind_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "floor",
              "waived_through",
              "date",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "area": {
                "type": "string",
                "pattern": "^[A-Z]{2,8}$"
              },
              "floor": {
                "type": "integer",
                "minimum": 1
              },
              "waived_through": {
                "type": "integer",
                "maximum": 9999
              },
              "date": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
